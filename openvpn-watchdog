#!/usr/bin/env bash
#
# openvpn-watchdog
# ----------------
# Watches one or more OpenVPN systemd profiles and restarts only the broken
# OpenVPN service. It does NOT reboot the computer. Machine reboot logic is
# planned as a separate package/service.
#
# Main rules:
#   * SERVER profiles: check only the systemd service state.
#   * CLIENT profiles: check the systemd service state, then optionally check
#     VPN-side connectivity by ICMP ping= targets only.
#
# Internet checks can use ping, HTTP(S) via curl, or auto mode. This is useful
# when an ISP/firewall blocks ICMP but HTTPS connectivity still works.
#
# The script writes structured event logs and can call a notification hook.
# User-facing messages and notification text support English and Ukrainian.
#
# Dry-run mode is intentionally read-only: it does not restart services, does
# not call notification hooks, and does not update persistent state counters.

set -o pipefail

VERSION="0.2.2"
SCRIPT_NAME="$(basename "$0")"
DEFAULT_CONFIG_FILE="/etc/openvpn-watchdog.conf"
CONFIG_FILE="${OPENVPN_WATCHDOG_CONFIG:-$DEFAULT_CONFIG_FILE}"
DRY_RUN="NO"

# -----------------------------------------------------------------------------
# Language and user-interface helpers
# -----------------------------------------------------------------------------
# User-facing messages are intentionally kept outside this script. Translation
# files are installed into /usr/share/openvpn-watchdog/locale/ and can also be
# used directly from ./locale/ when running the project from a source checkout.
#
# Supported languages:
#   auto - detect from LANG/LC_ALL/LC_MESSAGES;
#   en   - English;
#   uk   - Ukrainian.
#
# The notification hook receives active-language text plus English/Ukrainian
# variants. This keeps future Email/Matrix integrations simple and predictable.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
DEFAULT_LOCALE_DIR="/usr/share/openvpn-watchdog/locale"
OPENVPN_WATCHDOG_LOCALE_DIR="${OPENVPN_WATCHDOG_LOCALE_DIR:-}"
OPENVPN_WATCHDOG_LANGUAGE="${OPENVPN_WATCHDOG_LANGUAGE:-auto}"
ACTIVE_LANGUAGE="en"
CLI_LANGUAGE_SET="NO"

normalize_language() {
    local value="${1:-auto}"
    value="${value,,}"

    if [ "$value" = "auto" ] || [ -z "$value" ]; then
        value="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
        value="${value,,}"
    fi

    case "$value" in
        uk|uk_*|uk.*|ua|ua_*|ua.*)
            printf 'uk'
            ;;
        *)
            printf 'en'
            ;;
    esac
}

set_active_language() {
    ACTIVE_LANGUAGE="$(normalize_language "${1:-auto}")"
}

# Return the directory that contains translation files.  The explicit
# OPENVPN_WATCHDOG_LOCALE_DIR value has priority.  When running from a Git
# checkout, ./locale is used automatically.  Installed packages use
# /usr/share/openvpn-watchdog/locale.
get_locale_dir() {
    if [ -n "${OPENVPN_WATCHDOG_LOCALE_DIR:-}" ]; then
        printf '%s' "$OPENVPN_WATCHDOG_LOCALE_DIR"
    elif [ -d "${SCRIPT_DIR}/locale" ]; then
        printf '%s' "${SCRIPT_DIR}/locale"
    else
        printf '%s' "$DEFAULT_LOCALE_DIR"
    fi
}

locale_file_for_lang() {
    local lang="$(normalize_language "${1:-en}")"
    printf '%s/%s.conf' "$(get_locale_dir)" "$lang"
}

# Read a message template from the selected external locale file.
# Locale files define variables named I18N_<key>.  If a translated key is
# missing, English is used as fallback.  If even English is missing, the key
# itself is returned so the caller still gets a useful diagnostic string.
message_template() {
    local lang="$1"
    local key="$2"
    local file
    local var_name
    local template=""

    lang="$(normalize_language "$lang")"
    file="$(locale_file_for_lang "$lang")"
    var_name="I18N_${key}"

    if [ -f "$file" ]; then
        # shellcheck disable=SC1090
        template="$({ source "$file"; printf '%s' "${!var_name:-}"; } 2>/dev/null || true)"
    fi

    if [ -z "$template" ] && [ "$lang" != "en" ]; then
        message_template "en" "$key"
        return
    fi

    if [ -z "$template" ]; then
        case "$key" in
            error_option_requires_value) printf '%s' 'ERROR: %s requires a value' ;;
            error_unknown_argument) printf '%s' 'ERROR: unknown argument: %s' ;;
            *) printf '%s' "$key" ;;
        esac
    else
        printf '%s' "$template"
    fi
}

format_message() {
    local lang="$1"
    local key="$2"
    local template
    shift 2
    template="$(message_template "$lang" "$key")"
    # shellcheck disable=SC2059
    printf "$template" "$@"
}

msg() {
    format_message "$ACTIVE_LANGUAGE" "$@"
}

set_active_language "$OPENVPN_WATCHDOG_LANGUAGE"

# -----------------------------------------------------------------------------
# Argument parser
# -----------------------------------------------------------------------------
# Supports a small set of safe operational flags. The default mode is a single
# check cycle, suitable for systemd timer or cron.
show_help() {
    format_message "$ACTIVE_LANGUAGE" help_text "$VERSION" "$SCRIPT_NAME" "$DEFAULT_CONFIG_FILE"
    printf '\n'
}


while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            if [ -z "${2:-}" ]; then
                echo "$(msg error_option_requires_value --config)" >&2
                exit 2
            fi
            CONFIG_FILE="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN="YES"
            shift
            ;;
        --language)
            if [ -z "${2:-}" ]; then
                echo "$(msg error_option_requires_value --language)" >&2
                exit 2
            fi
            OPENVPN_WATCHDOG_LANGUAGE="$2"
            CLI_LANGUAGE_SET="YES"
            set_active_language "$OPENVPN_WATCHDOG_LANGUAGE"
            shift 2
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        --version|-V)
            echo "${VERSION}"
            exit 0
            ;;
        *)
            echo "$(msg error_unknown_argument "$1")" >&2
            show_help >&2
            exit 2
            ;;
    esac
done

# -----------------------------------------------------------------------------
# Defaults
# -----------------------------------------------------------------------------
# These values may be overridden in /etc/openvpn-watchdog.conf.
HOST_SHORT="${HOSTNAME%%.*}"
LOG_DIR="/var/log/openvpn-watchdog"
STATE_DIR="/var/lib/openvpn-watchdog"
LOG_RETENTION_DAYS=30

PING_COUNT=3
PING_TIMEOUT=3
DEFAULT_RESTART_CYCLES=3
RESTART_COOLDOWN_SECONDS=60

# Internet availability guard.
#   INTERNET_CHECK_METHOD=auto  -> try HTTP targets first, then ping targets.
#   INTERNET_CHECK_METHOD=http  -> use only HTTP(S) targets through curl.
#   INTERNET_CHECK_METHOD=ping  -> use only ICMP ping targets.
INTERNET_CHECK_ENABLED="YES"
INTERNET_CHECK_METHOD="auto"
PING_SERVER_INT="8.8.8.8,1.1.1.1"
HTTP_SERVER_INT="https://www.google.com,https://cloudflare.com"
# VPN CLIENT ping checks may be skipped while the global Internet check fails.
SKIP_CLIENT_PING_WHEN_INTERNET_DOWN="YES"
# Backward-compatible alias from early 0.2.0 configs.
SKIP_CLIENT_CONNECTIVITY_WHEN_INTERNET_DOWN=""

# HTTP(S) connectivity settings are used only by the global Internet check.
# VPN CLIENT profiles intentionally use ICMP ping= only.
HTTP_CONNECT_TIMEOUT=8
HTTP_MAX_TIME=12
HTTP_IP_VERSION="4"       # 4, 6, or auto
HTTP_REQUEST_METHOD="HEAD" # HEAD or GET

NOTIFICATIONS_ENABLED="NO"
NOTIFY_SCRIPT=""

LOG_ANALYSIS_ENABLED="YES"
LOG_ANALYSIS_ON_PROBLEM_ONLY="YES"
LOG_ANALYSIS_LINES=120
LOG_ANALYSIS_MAX_MATCHES=5
LOG_ANALYSIS_PATTERNS="AUTH_FAILED|TLS Error|Inactivity timeout|Connection reset|Cannot resolve host address|VERIFY ERROR|Options error|Exiting due to fatal error"

# Empty by default. The config file should define this array.
declare -a OPENVPN_PROFILES=()

# -----------------------------------------------------------------------------
# Logging helpers
# -----------------------------------------------------------------------------
# save_log writes a human-readable daily log and mirrors the message to stdout.
# emit_event_i18n writes a machine-readable event log and can call the
# notification hook. Future Matrix/Email integrations should consume the event
# data and hook environment variables, not parse random console text.
ensure_dirs() {
    if [ "$DRY_RUN" = "YES" ]; then
        return 0
    fi

    mkdir -p "$LOG_DIR" "$STATE_DIR"
}

log_file_for_today() {
    printf '%s/%s-%s.log' "$LOG_DIR" "$(date +%Y.%m.%d)" "$HOST_SHORT"
}

save_log() {
    local level="$1"
    local message="$2"
    local line

    if [ "$DRY_RUN" = "YES" ]; then
        line="$(date '+%Y-%m-%d %H:%M:%S') [$level] [DRY-RUN] $message"
        echo "$line"
        return 0
    fi

    line="$(date '+%Y-%m-%d %H:%M:%S') [$level] $message"
    echo "$line" >> "$(log_file_for_today)"
    echo "$line"
}

# Escape tabs/newlines from event fields so the event log remains one event per
# line and is easy to process later.
event_escape() {
    local value="$1"
    value="${value//$'\t'/ }"
    value="${value//$'\n'/ }"
    printf '%s' "$value"
}

emit_event_raw() {
    local severity="$1"
    local profile="$2"
    local profile_type="$3"
    local service_name="$4"
    local event_name="$5"
    local message="$6"
    local message_en="${7:-$6}"
    local message_uk="${8:-$6}"
    local now
    local event_log

    now="$(date '+%Y-%m-%dT%H:%M:%S%z')"
    event_log="${LOG_DIR}/events.log"

    if [ "$DRY_RUN" = "YES" ]; then
        save_log "$severity" "[$profile][$event_name] $message"
        return 0
    fi

    printf '%s\tseverity=%s\tprofile=%s\ttype=%s\tservice=%s\tevent=%s\tlanguage=%s\tmessage=%s
' \
        "$now" \
        "$(event_escape "$severity")" \
        "$(event_escape "$profile")" \
        "$(event_escape "$profile_type")" \
        "$(event_escape "$service_name")" \
        "$(event_escape "$event_name")" \
        "$(event_escape "$ACTIVE_LANGUAGE")" \
        "$(event_escape "$message")" >> "$event_log"

    save_log "$severity" "[$profile][$event_name] $message"

    # Notification hook contract:
    #   The hook receives active-language text plus English/Ukrainian variants.
    #   It may later be implemented as Email, Matrix, Telegram, monitoring API,
    #   etc. In --dry-run mode hooks are never executed.
    if [ "$NOTIFICATIONS_ENABLED" = "YES" ] && [ -n "$NOTIFY_SCRIPT" ]; then
        if [ -x "$NOTIFY_SCRIPT" ]; then
            OPENVPN_WATCHDOG_TIME="$now" \
            OPENVPN_WATCHDOG_SEVERITY="$severity" \
            OPENVPN_WATCHDOG_PROFILE="$profile" \
            OPENVPN_WATCHDOG_TYPE="$profile_type" \
            OPENVPN_WATCHDOG_SERVICE="$service_name" \
            OPENVPN_WATCHDOG_EVENT="$event_name" \
            OPENVPN_WATCHDOG_LANGUAGE="$ACTIVE_LANGUAGE" \
            OPENVPN_WATCHDOG_MESSAGE="$message" \
            OPENVPN_WATCHDOG_MESSAGE_EN="$message_en" \
            OPENVPN_WATCHDOG_MESSAGE_UK="$message_uk" \
            OPENVPN_WATCHDOG_LOG_FILE="$(log_file_for_today)" \
            OPENVPN_WATCHDOG_EVENT_LOG="$event_log" \
                "$NOTIFY_SCRIPT" || save_log "WARNING" "$(msg notification_hook_failed "$NOTIFY_SCRIPT")"
        else
            save_log "WARNING" "$(msg notification_hook_not_executable "$NOTIFY_SCRIPT")"
        fi
    fi
}

emit_event_i18n() {
    local severity="$1"
    local profile="$2"
    local profile_type="$3"
    local service_name="$4"
    local event_name="$5"
    local message_key="$6"
    shift 6

    local message
    local message_en
    local message_uk

    message="$(format_message "$ACTIVE_LANGUAGE" "$message_key" "$@")"
    message_en="$(format_message "en" "$message_key" "$@")"
    message_uk="$(format_message "uk" "$message_key" "$@")"

    emit_event_raw "$severity" "$profile" "$profile_type" "$service_name" "$event_name" "$message" "$message_en" "$message_uk"
}

cleanup_old_logs() {
    if [ "$DRY_RUN" = "YES" ]; then
        return 0
    fi

    if [ "${LOG_RETENTION_DAYS:-0}" -gt 0 ]; then
        find "$LOG_DIR" -type f -mtime +"$LOG_RETENTION_DAYS" -print0 2>/dev/null | xargs -0 --no-run-if-empty rm -f
    fi
}

# -----------------------------------------------------------------------------
# Config loading and validation
# -----------------------------------------------------------------------------
load_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        ensure_dirs
        save_log "ERROR" "$(msg error_config_not_found "$CONFIG_FILE")"
        exit 1
    fi

    # shellcheck source=/etc/openvpn-watchdog.conf
    source "$CONFIG_FILE"

    if [ "$CLI_LANGUAGE_SET" != "YES" ]; then
        set_active_language "${OPENVPN_WATCHDOG_LANGUAGE:-auto}"
    fi
    normalize_internet_method
    ensure_dirs
    cleanup_old_logs
}

normalize_type() {
    local value="$1"
    printf '%s' "${value^^}"
}

normalize_method() {
    local value="${1:-auto}"
    value="${value,,}"
    case "$value" in
        auto|ping|http)
            printf '%s' "$value"
            ;;
        *)
            printf 'auto'
            ;;
    esac
}

normalize_internet_method() {
    local original="${INTERNET_CHECK_METHOD:-auto}"
    INTERNET_CHECK_METHOD="$(normalize_method "$original")"
    if [ "${original,,}" != "$INTERNET_CHECK_METHOD" ]; then
        save_log "WARNING" "$(msg invalid_internet_method "$original")"
    fi
}

safe_id() {
    local value="$1"
    value="${value//[^A-Za-z0-9_.-]/_}"
    printf '%s' "$value"
}

is_systemd_available() {
    [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

# -----------------------------------------------------------------------------
# State helpers
# -----------------------------------------------------------------------------
# Each profile has its own state file. This prevents one broken VPN from
# affecting counters or recovery detection for another VPN.
load_profile_state() {
    local profile_id="$1"

    PROFILE_STATE_FILE="${STATE_DIR}/${profile_id}.state"
    SERVICE_FAIL_COUNT=0
    CONNECTIVITY_FAIL_COUNT=0
    PING_FAIL_COUNT=0 # kept for compatibility with old state files
    LAST_SERVICE_RESULT="unknown"
    LAST_CONNECTIVITY_RESULT="unknown"
    LAST_PING_RESULT="unknown" # kept for compatibility with old state files
    LAST_RESTART_EPOCH=0
    LAST_LOG_SIGNATURE=""

    # Dry-run must be repeatable and read-only. It intentionally ignores
    # persisted counters so a test run does not show confusing old cycles.
    if [ "$DRY_RUN" = "YES" ]; then
        return 0
    fi

    if [ -f "$PROFILE_STATE_FILE" ]; then
        # shellcheck disable=SC1090
        source "$PROFILE_STATE_FILE"
        if [ "${LAST_CONNECTIVITY_RESULT:-unknown}" = "unknown" ] && [ "${LAST_PING_RESULT:-unknown}" != "unknown" ]; then
            LAST_CONNECTIVITY_RESULT="$LAST_PING_RESULT"
        fi
        if [ "${CONNECTIVITY_FAIL_COUNT:-0}" -eq 0 ] && [ "${PING_FAIL_COUNT:-0}" -gt 0 ]; then
            CONNECTIVITY_FAIL_COUNT="$PING_FAIL_COUNT"
        fi
    fi
}

save_profile_state() {
    if [ "$DRY_RUN" = "YES" ]; then
        return 0
    fi

    cat > "$PROFILE_STATE_FILE" <<STATE
SERVICE_FAIL_COUNT=$(printf '%q' "$SERVICE_FAIL_COUNT")
CONNECTIVITY_FAIL_COUNT=$(printf '%q' "$CONNECTIVITY_FAIL_COUNT")
LAST_SERVICE_RESULT=$(printf '%q' "$LAST_SERVICE_RESULT")
LAST_CONNECTIVITY_RESULT=$(printf '%q' "$LAST_CONNECTIVITY_RESULT")
LAST_RESTART_EPOCH=$(printf '%q' "$LAST_RESTART_EPOCH")
LAST_LOG_SIGNATURE=$(printf '%q' "$LAST_LOG_SIGNATURE")
STATE
}

load_global_state() {
    GLOBAL_STATE_FILE="${STATE_DIR}/global.state"
    LAST_INTERNET_RESULT="unknown"
    INTERNET_FAIL_COUNT=0

    # Dry-run must not depend on previous persistent counters.
    if [ "$DRY_RUN" = "YES" ]; then
        return 0
    fi

    if [ -f "$GLOBAL_STATE_FILE" ]; then
        # shellcheck disable=SC1090
        source "$GLOBAL_STATE_FILE"
    fi
}

save_global_state() {
    if [ "$DRY_RUN" = "YES" ]; then
        return 0
    fi

    cat > "$GLOBAL_STATE_FILE" <<STATE
LAST_INTERNET_RESULT=$(printf '%q' "$LAST_INTERNET_RESULT")
INTERNET_FAIL_COUNT=$(printf '%q' "$INTERNET_FAIL_COUNT")
STATE
}

# -----------------------------------------------------------------------------
# Connectivity helpers: ICMP ping and HTTP(S) curl
# -----------------------------------------------------------------------------
# Comma-separated target lists return success when at least one target works.
# This avoids false positives when one public endpoint is temporarily blocked.
trim_spaces() {
    local value="$1"
    value="${value#${value%%[![:space:]]*}}"
    value="${value%${value##*[![:space:]]}}"
    printf '%s' "$value"
}

has_csv_targets() {
    local targets="${1// /}"
    [ -n "$targets" ]
}

ping_one_target() {
    local target="$1"
    target="$(trim_spaces "$target")"

    if [ -z "$target" ]; then
        return 1
    fi

    ping -c "$PING_COUNT" -W "$PING_TIMEOUT" "$target" >/dev/null 2>&1
}

ping_targets() {
    local targets_csv="$1"
    local old_ifs="$IFS"
    local target
    local result=1

    IFS=','
    for target in $targets_csv; do
        if ping_one_target "$target"; then
            result=0
            break
        fi
    done
    IFS="$old_ifs"

    return "$result"
}

curl_one_target() {
    local url="$1"
    local method
    local ip_version
    local -a curl_args

    url="$(trim_spaces "$url")"
    if [ -z "$url" ]; then
        return 1
    fi
    if ! command -v curl >/dev/null 2>&1; then
        return 127
    fi

    method="${HTTP_REQUEST_METHOD^^}"
    ip_version="${HTTP_IP_VERSION,,}"
    curl_args=(-sS -o /dev/null --connect-timeout "$HTTP_CONNECT_TIMEOUT" --max-time "$HTTP_MAX_TIME")

    case "$ip_version" in
        4|ipv4)
            curl_args=(-4 "${curl_args[@]}")
            ;;
        6|ipv6)
            curl_args=(-6 "${curl_args[@]}")
            ;;
        auto|any|"")
            ;;
        *)
            curl_args=(-4 "${curl_args[@]}")
            ;;
    esac

    if [ "$method" = "GET" ]; then
        curl "${curl_args[@]}" "$url" >/dev/null 2>&1
    else
        curl -I "${curl_args[@]}" "$url" >/dev/null 2>&1
    fi
}

http_targets() {
    local targets_csv="$1"
    local old_ifs="$IFS"
    local target
    local result=1
    local curl_missing=0

    IFS=','
    for target in $targets_csv; do
        if curl_one_target "$target"; then
            result=0
            break
        else
            if [ "$?" -eq 127 ]; then
                curl_missing=1
            fi
        fi
    done
    IFS="$old_ifs"

    if [ "$result" -ne 0 ] && [ "$curl_missing" -eq 1 ]; then
        return 127
    fi
    return "$result"
}

connectivity_description() {
    local method="$1"
    local ping_csv="$2"
    local http_csv="$3"

    case "$method" in
        ping)
            printf 'ping=%s' "$ping_csv"
            ;;
        http)
            printf 'http=%s' "$http_csv"
            ;;
        *)
            local sep=""
            if has_csv_targets "$http_csv"; then
                printf 'http=%s' "$http_csv"
                sep=' '
            fi
            if has_csv_targets "$ping_csv"; then
                printf '%sping=%s' "$sep" "$ping_csv"
            fi
            ;;
    esac
}

check_connectivity_targets() {
    local method="$1"
    local ping_csv="$2"
    local http_csv="$3"
    local http_result=1
    local ping_result=1

    method="$(normalize_method "$method")"

    case "$method" in
        http)
            has_csv_targets "$http_csv" || return 1
            http_targets "$http_csv"
            ;;
        ping)
            has_csv_targets "$ping_csv" || return 1
            ping_targets "$ping_csv"
            ;;
        auto|*)
            # Prefer HTTP in auto mode because many providers/firewalls block
            # ICMP. If HTTP is not configured or fails, fall back to ping.
            if has_csv_targets "$http_csv"; then
                http_targets "$http_csv"
                http_result=$?
                if [ "$http_result" -eq 0 ]; then
                    return 0
                fi
            fi
            if has_csv_targets "$ping_csv"; then
                ping_targets "$ping_csv"
                ping_result=$?
                if [ "$ping_result" -eq 0 ]; then
                    return 0
                fi
            fi
            if [ "$http_result" -eq 127 ]; then
                return 127
            fi
            return 1
            ;;
    esac
}

check_internet() {
    INTERNET_OK="unknown"

    if [ "$INTERNET_CHECK_ENABLED" != "YES" ]; then
        INTERNET_OK="skipped"
        return 0
    fi

    load_global_state

    local target_description
    local check_result
    target_description="$(connectivity_description "$INTERNET_CHECK_METHOD" "$PING_SERVER_INT" "$HTTP_SERVER_INT")"

    check_connectivity_targets "$INTERNET_CHECK_METHOD" "$PING_SERVER_INT" "$HTTP_SERVER_INT"
    check_result=$?

    if [ "$check_result" -eq 0 ]; then
        INTERNET_OK="YES"
        INTERNET_FAIL_COUNT=0
        if [ "$LAST_INTERNET_RESULT" != "available" ]; then
            emit_event_i18n "INFO" "GLOBAL" "GLOBAL" "-" "internet_available" internet_available "$INTERNET_CHECK_METHOD" "$target_description"
        fi
        LAST_INTERNET_RESULT="available"
    else
        INTERNET_OK="NO"
        INTERNET_FAIL_COUNT=$((INTERNET_FAIL_COUNT + 1))
        if [ "$check_result" -eq 127 ]; then
            emit_event_i18n "ERROR" "GLOBAL" "GLOBAL" "-" "curl_missing" curl_missing "$INTERNET_CHECK_METHOD"
        fi
        if [ "$LAST_INTERNET_RESULT" != "unavailable" ]; then
            emit_event_i18n "WARNING" "GLOBAL" "GLOBAL" "-" "internet_unavailable" internet_unavailable "$INTERNET_CHECK_METHOD" "$target_description"
        else
            save_log "WARNING" "[GLOBAL][internet_unavailable] $(msg internet_still_unavailable "$INTERNET_FAIL_COUNT")"
        fi
        LAST_INTERNET_RESULT="unavailable"
    fi

    save_global_state
}

# -----------------------------------------------------------------------------
# Service helpers
# -----------------------------------------------------------------------------
# Profile service names may be explicitly configured with service=...
# Otherwise they are generated using the common OpenVPN systemd naming pattern:
#   SERVER: openvpn-server@<name>-server.service
#   CLIENT: openvpn-client@<name>-client.service
build_service_name() {
    local name="$1"
    local type="$2"
    local explicit_service="$3"

    if [ -n "$explicit_service" ]; then
        printf '%s' "$explicit_service"
        return 0
    fi

    case "$type" in
        SERVER)
            printf 'openvpn-server@%s-server.service' "$name"
            ;;
        CLIENT)
            printf 'openvpn-client@%s-client.service' "$name"
            ;;
        *)
            return 1
            ;;
    esac
}

service_is_active() {
    local service_name="$1"

    if is_systemd_available; then
        systemctl is-active --quiet "$service_name"
    else
        # Non-systemd support is intentionally conservative. Old systems often
        # manage all OpenVPN profiles through one init script, so only generic
        # status is available.
        /sbin/service openvpn status >/dev/null 2>&1
    fi
}

restart_service() {
    local profile_name="$1"
    local profile_type="$2"
    local service_name="$3"
    local reason="$4"
    local now_epoch

    now_epoch="$(date +%s)"

    if [ "$RESTART_COOLDOWN_SECONDS" -gt 0 ] && [ "$LAST_RESTART_EPOCH" -gt 0 ]; then
        local since_last_restart
        since_last_restart=$((now_epoch - LAST_RESTART_EPOCH))
        if [ "$since_last_restart" -lt "$RESTART_COOLDOWN_SECONDS" ]; then
            emit_event_i18n "WARNING" "$profile_name" "$profile_type" "$service_name" "restart_skipped_cooldown" restart_skipped_cooldown "$since_last_restart" "$RESTART_COOLDOWN_SECONDS" "$reason"
            return 0
        fi
    fi

    emit_event_i18n "WARNING" "$profile_name" "$profile_type" "$service_name" "restart_requested" restart_requested "$reason"

    if [ "$DRY_RUN" = "YES" ]; then
        save_log "INFO" "[$profile_name][dry_run] $(msg dry_run_would_restart "$service_name")"
        return 0
    fi

    if is_systemd_available; then
        if systemctl restart "$service_name"; then
            LAST_RESTART_EPOCH="$now_epoch"
            emit_event_i18n "INFO" "$profile_name" "$profile_type" "$service_name" "restart_done" restart_done
        else
            emit_event_i18n "ERROR" "$profile_name" "$profile_type" "$service_name" "restart_failed" restart_failed_systemctl
            return 1
        fi
    else
        if /sbin/service openvpn restart; then
            LAST_RESTART_EPOCH="$now_epoch"
            emit_event_i18n "INFO" "$profile_name" "$profile_type" "$service_name" "restart_done" restart_done_init
        else
            emit_event_i18n "ERROR" "$profile_name" "$profile_type" "$service_name" "restart_failed" restart_failed_init
            return 1
        fi
    fi
}

# -----------------------------------------------------------------------------
# Log analysis
# -----------------------------------------------------------------------------
# This is intentionally small and safe. It does not make restart decisions by
# itself yet. It only records useful events when common OpenVPN error patterns
# appear near the problem time. Later Email/Matrix notifications can use these
# structured events.
analyze_service_logs() {
    local profile_name="$1"
    local profile_type="$2"
    local service_name="$3"
    local reason="$4"
    local matches
    local signature
    local first_line
    local count

    if [ "$LOG_ANALYSIS_ENABLED" != "YES" ]; then
        return 0
    fi
    if ! is_systemd_available; then
        return 0
    fi
    if [ -z "$LOG_ANALYSIS_PATTERNS" ]; then
        return 0
    fi

    matches="$(journalctl -u "$service_name" -n "$LOG_ANALYSIS_LINES" --no-pager 2>/dev/null | grep -E "$LOG_ANALYSIS_PATTERNS" | tail -n "$LOG_ANALYSIS_MAX_MATCHES")"

    if [ -z "$matches" ]; then
        return 0
    fi

    if command -v sha256sum >/dev/null 2>&1; then
        signature="$(printf '%s' "$matches" | sha256sum | awk '{print $1}')"
    else
        signature="$(printf '%s' "$matches" | cksum | awk '{print $1}')"
    fi

    if [ "$signature" = "$LAST_LOG_SIGNATURE" ]; then
        return 0
    fi

    LAST_LOG_SIGNATURE="$signature"
    count="$(printf '%s\n' "$matches" | grep -c '^' || true)"
    first_line="$(printf '%s\n' "$matches" | head -n 1)"

    emit_event_i18n "WARNING" "$profile_name" "$profile_type" "$service_name" "log_pattern_detected" log_pattern_detected "$count" "$reason" "$first_line"
}

# -----------------------------------------------------------------------------
# Profile parser and processor
# -----------------------------------------------------------------------------
# Profile format in config:
#   "name=office type=CLIENT ping=10.8.0.1 restart_cycles=3"
#   "name=main type=SERVER restart_cycles=3"
#
# Important:
#   HTTP(S) checks are supported only for the global INTERNET_CHECK.
#   VPN CLIENT profiles use ping= only because the tunnel itself must pass ICMP.
#
# Optional:
#   service=openvpn-client@custom.service
#
# Values should not contain spaces. This keeps the config readable and avoids
# unsafe eval parsing.
parse_profile() {
    local profile_def="$1"
    local item
    local key
    local value

    PROFILE_NAME=""
    PROFILE_TYPE=""
    PROFILE_PING=""
    PROFILE_SERVICE=""
    PROFILE_RESTART_CYCLES="$DEFAULT_RESTART_CYCLES"

    for item in $profile_def; do
        key="${item%%=*}"
        value="${item#*=}"
        case "$key" in
            name)
                PROFILE_NAME="$value"
                ;;
            type)
                PROFILE_TYPE="$(normalize_type "$value")"
                ;;
            ping)
                PROFILE_PING="$value"
                ;;
            http|url)
                save_log "WARNING" "$(msg profile_http_unsupported "${PROFILE_NAME:-unknown}" "$key")"
                ;;
            service)
                PROFILE_SERVICE="$value"
                ;;
            restart_cycles)
                PROFILE_RESTART_CYCLES="$value"
                ;;
            *)
                save_log "WARNING" "$(msg unknown_profile_parameter "$key" "$profile_def")"
                ;;
        esac
    done

    if [ -z "$PROFILE_NAME" ]; then
        save_log "ERROR" "$(msg profile_no_name "$profile_def")"
        return 1
    fi
    if [ "$PROFILE_TYPE" != "SERVER" ] && [ "$PROFILE_TYPE" != "CLIENT" ]; then
        save_log "ERROR" "$(msg invalid_profile_type "$PROFILE_NAME" "$PROFILE_TYPE")"
        return 1
    fi
    if ! [[ "$PROFILE_RESTART_CYCLES" =~ ^[0-9]+$ ]] || [ "$PROFILE_RESTART_CYCLES" -lt 1 ]; then
        save_log "WARNING" "$(msg invalid_restart_cycles "$PROFILE_NAME" "$PROFILE_RESTART_CYCLES" "$DEFAULT_RESTART_CYCLES")"
        PROFILE_RESTART_CYCLES="$DEFAULT_RESTART_CYCLES"
    fi

    return 0
}

process_profile() {
    local profile_def="$1"
    local profile_id
    local service_name
    local vpn_ping_description
    local ping_result

    if ! parse_profile "$profile_def"; then
        return 1
    fi

    profile_id="$(safe_id "$PROFILE_NAME")"
    load_profile_state "$profile_id"

    if ! service_name="$(build_service_name "$PROFILE_NAME" "$PROFILE_TYPE" "$PROFILE_SERVICE")"; then
        emit_event_i18n "ERROR" "$PROFILE_NAME" "$PROFILE_TYPE" "-" "invalid_service_name" invalid_service_name
        save_profile_state
        return 1
    fi

    # 1) SERVER and CLIENT: service must be active.
    #    If the service is down, restart immediately. Connectivity checks are
    #    not useful until the service itself is healthy.
    if service_is_active "$service_name"; then
        SERVICE_FAIL_COUNT=0
        if [ "$LAST_SERVICE_RESULT" != "active" ]; then
            emit_event_i18n "INFO" "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "service_active" service_active
        fi
        LAST_SERVICE_RESULT="active"
    else
        SERVICE_FAIL_COUNT=$((SERVICE_FAIL_COUNT + 1))
        LAST_SERVICE_RESULT="inactive"
        emit_event_i18n "ERROR" "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "service_inactive" service_inactive "$SERVICE_FAIL_COUNT"
        analyze_service_logs "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "service_inactive"
        restart_service "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "$(msg reason_service_inactive)"
        save_profile_state
        return 0
    fi

    # 2) SERVER: service check is enough. VPN ping targets are ignored to avoid
    #    false alarms when no clients are connected.
    if [ "$PROFILE_TYPE" = "SERVER" ]; then
        CONNECTIVITY_FAIL_COUNT=0
        LAST_CONNECTIVITY_RESULT="not_required"
        if has_csv_targets "$PROFILE_PING"; then
            emit_event_i18n "WARNING" "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "server_ping_ignored" server_ping_ignored "$PROFILE_PING"
        fi
        save_profile_state
        return 0
    fi

    # 3) CLIENT without ping=: only service is watched.
    if ! has_csv_targets "$PROFILE_PING"; then
        CONNECTIVITY_FAIL_COUNT=0
        LAST_CONNECTIVITY_RESULT="not_configured"
        save_profile_state
        return 0
    fi

    # 4) CLIENT with ping=: check VPN-side availability using ICMP only.
    #    HTTP(S)/curl checks are intentionally limited to INTERNET_CHECK.
    #    If global Internet is down, avoid restarting all clients just because
    #    the host has no outside connectivity.
    local skip_when_down="${SKIP_CLIENT_PING_WHEN_INTERNET_DOWN:-YES}"
    if [ -n "${SKIP_CLIENT_CONNECTIVITY_WHEN_INTERNET_DOWN:-}" ]; then
        skip_when_down="$SKIP_CLIENT_CONNECTIVITY_WHEN_INTERNET_DOWN"
    fi
    if [ "$INTERNET_OK" = "NO" ] && [ "$skip_when_down" = "YES" ]; then
        emit_event_i18n "WARNING" "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "client_ping_skipped" client_ping_skipped
        save_profile_state
        return 0
    fi

    vpn_ping_description="ping=$PROFILE_PING"
    ping_targets "$PROFILE_PING"
    ping_result=$?

    if [ "$ping_result" -eq 0 ]; then
        CONNECTIVITY_FAIL_COUNT=0
        if [ "$LAST_CONNECTIVITY_RESULT" != "available" ]; then
            emit_event_i18n "INFO" "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "vpn_ping_available" vpn_ping_available "$vpn_ping_description"
        fi
        LAST_CONNECTIVITY_RESULT="available"
    else
        CONNECTIVITY_FAIL_COUNT=$((CONNECTIVITY_FAIL_COUNT + 1))
        LAST_CONNECTIVITY_RESULT="unavailable"
        emit_event_i18n "WARNING" "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "vpn_ping_unavailable" vpn_ping_unavailable "$vpn_ping_description" "$CONNECTIVITY_FAIL_COUNT" "$PROFILE_RESTART_CYCLES"
        analyze_service_logs "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "vpn_ping_unavailable"

        if [ "$CONNECTIVITY_FAIL_COUNT" -ge "$PROFILE_RESTART_CYCLES" ]; then
            restart_service "$PROFILE_NAME" "$PROFILE_TYPE" "$service_name" "$(msg reason_vpn_ping_unavailable "$vpn_ping_description")"
            CONNECTIVITY_FAIL_COUNT=0
        fi
    fi

    save_profile_state
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
    load_config

    if [ "${#OPENVPN_PROFILES[@]}" -eq 0 ]; then
        save_log "ERROR" "$(msg no_profiles_configured "$CONFIG_FILE")"
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        save_log "WARNING" "$(msg not_root_warning)"
    fi

    check_internet

    local profile_def
    for profile_def in "${OPENVPN_PROFILES[@]}"; do
        process_profile "$profile_def"
    done
}

main "$@"
